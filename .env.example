# Copy to .env or set these in your host's dashboard.

# REQUIRED in production — 32+ random characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# The account that gets moderation powers when it signs up.
ADMIN_EMAIL=sipra.chant@gmail.com

# Where the SQLite file lives. Point this at persistent storage,
# or the guestbook resets on every deploy.
DB_PATH=/data/portfolio.db

# Set to 1 when served over HTTPS behind a proxy (Render, Railway, Fly).
# Turns on Secure cookies, HSTS, and trusting X-Forwarded-For.
TRUST_PROXY=1

# New accounts per hour from one address. Raise it if you share the link
# somewhere a roomful of people are behind one connection.
REGISTER_MAX_PER_HOUR=10

# PORT is normally set by the host.
# PORT=3000
